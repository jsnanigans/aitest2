{
  "info": {
    "name": "Weight Processor API",
    "description": "Collection for testing the Weight Processor Lambda API locally and in AWS. Import this collection into Postman to test all endpoints with sample data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5448",
      "type": "string",
      "description": "Base URL for local development. Change to your AWS API Gateway URL for cloud testing."
    },
    {
      "key": "api_version",
      "value": "api/v1",
      "type": "string"
    },
    {
      "key": "test_user_id",
      "value": "user-123",
      "type": "string",
      "description": "Default test user ID"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{api_version}}/health",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "health"]
            },
            "description": "Check the health status of the Lambda function and all its components"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Process Measurements",
      "item": [
        {
          "name": "Process Single Measurement",
          "request": {
            "method": "POST",
