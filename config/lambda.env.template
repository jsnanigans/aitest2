# Lambda Environment Variables Template
# Copy this file to .env.lambda and fill in your values

# Database Configuration
DB_BACKEND=dynamodb
DYNAMODB_TABLE=weight-processor-state
AWS_REGION=us-east-1

# Kalman Filter Configuration
KALMAN_PROCESS_NOISE=0.1
KALMAN_OBSERVATION_NOISE=1.0
KALMAN_INITIAL_COVARIANCE=1.0
KALMAN_ADAPTATION_ENABLED=true
KALMAN_RESET_WINDOW_HOURS=720

# Quality Scoring Configuration
QUALITY_SCORING_ENABLED=true
QS_WEIGHT_KALMAN=0.25
QS_WEIGHT_TEMPORAL=0.20
QS_WEIGHT_SOURCE=0.20
QS_WEIGHT_PHYSIO=0.15
QS_WEIGHT_STATISTICAL=0.10
QS_WEIGHT_FREQUENCY=0.10
QS_THRESHOLD_HIGH=0.8
QS_THRESHOLD_MEDIUM=0.5
QS_THRESHOLD_OUTLIER_OVERRIDE=0.85

# Processing Configuration
PROCESSING_EXTREME_THRESHOLD=0.15
PROCESSING_MAX_DAILY_CHANGE=2.0
PROCESSING_MIN_WEIGHT=20.0
PROCESSING_MAX_WEIGHT=500.0

# Replay Configuration
REPLAY_ENABLED=true
REPLAY_BUFFER_HOURS=72
REPLAY_TRIGGER_MODE=time_based
REPLAY_OUTLIER_METHODS=["iqr", "mad"]
REPLAY_IQR_MULTIPLIER=1.5
REPLAY_MAD_THRESHOLD=3.0
REPLAY_MAX_ATTEMPTS=3
REPLAY_MIN_MEASUREMENTS=10
REPLAY_ROLLBACK_ON_ERROR=true

# Snapshot Configuration
# Periodic snapshots ensure replay has adequate state history
SNAPSHOT_PERIODIC_ENABLED=true
SNAPSHOT_INTERVAL_HOURS=24
SNAPSHOT_RETENTION_DAYS=10

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN=3

# Service Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
SERVICE_VERSION=1.0.0