# Files and directories to exclude from Lambda deployment

# Local development only
src/local/
local/

# Test files
tests/
test_events/
test_filtered/
*_test.py
test_*.py
**/test_*.py
**/*_test.py

# Documentation
docs/
*.md
README*
LICENSE*
CHANGELOG*

# Development and build files
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
virtualenv/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# AWS SAM
.aws-sam/
samconfig.toml
template*.yaml

# Docker
docker/
docker-compose*.yml
Dockerfile*
.dockerignore

# Data and output
data/
output/
reports/
plans/
presentation/
*.csv
*.json
!event.json
*.log
*.db

# Scripts not needed in Lambda
scripts/
Makefile*

# Configuration files not needed
config/local/
.env*
env.json
*.toml
!pyproject.toml

# Visualization and analysis
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.html
visualization/
images/

