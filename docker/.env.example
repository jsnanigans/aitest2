# Docker SAM Environment Configuration
# Copy this file to .env and adjust as needed

# AWS Configuration (Local Development)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=local

# DynamoDB Configuration
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_TABLE_NAME=weight-processor-state
DYNAMODB_PORT=8000
DYNAMODB_ADMIN_PORT=8001

# SAM Local API Configuration
SAM_API_PORT=3000
SAM_LAMBDA_PORT=3001
SAM_NETWORK=sam-network

# Application Configuration
ENVIRONMENT=local
LOG_LEVEL=INFO

# Container Configuration
CONTAINER_HOST=host.docker.internal
SAM_CLI_TELEMETRY=0

# Build Configuration
PARALLEL_BUILDS=true
CACHE_BUILDS=true