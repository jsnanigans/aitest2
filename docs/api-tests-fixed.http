    {"uuid": "c50e8400-e29b-41d4-a716-446655440004", "weight": 75.0, "unit": "kg", "effectiveDateTime": "2024-01-01T03:00:00Z", "source": "patient-upload"},
    {"uuid": "c50e8400-e29b-41d4-a716-446655440005", "weight": 74.9, "unit": "kg", "effectiveDateTime": "2024-01-01T04:00:00Z", "source": "care-team-upload"},
