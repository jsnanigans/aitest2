    {"uuid": "c50e8400-e29b-41d4-a716-446655440007", "weight": 75.1, "unit": "kg", "effectiveDateTime": "2024-01-01T06:00:00Z", "source": "questionnaire"},
    {"uuid": "c50e8400-e29b-41d4-a716-446655440008", "weight": 75.0, "unit": "kg", "effectiveDateTime": "2024-01-01T07:00:00Z", "source": "patient-device"},
