FROM public.ecr.aws/lambda/python:3.12

# Install system dependencies
RUN yum update -y && \
    yum install -y \
    gcc \
    make \
    curl \
    unzip \
    tar \
    gzip \
    git \
    which \
    shadow-utils \
    && yum clean all

# Install Node.js 18 (required for SAM CLI)
RUN curl -sL https://rpm.nodesource.com/setup_18.x | bash - && \
    yum install -y nodejs

# Install AWS SAM CLI
RUN pip install --upgrade pip && \
    pip install aws-sam-cli

# Install Python dependencies for the application
COPY requirements-lambda.txt /tmp/
RUN pip install -r /tmp/requirements-lambda.txt

# Create a non-root user for running SAM
RUN useradd -m -s /bin/bash samuser

# Set working directory
WORKDIR /app

# Switch to non-root user
USER samuser

# Set environment variables for AWS credentials (local development)
ENV AWS_ACCESS_KEY_ID=local \
    AWS_SECRET_ACCESS_KEY=local \
    AWS_DEFAULT_REGION=us-east-1 \
    SAM_CLI_TELEMETRY=0

# Default command
CMD ["/bin/bash"]