# Docker-based SAM development Makefile

# Variables
COMPOSE_FILE := docker-compose.sam.yml
CONTAINER_NAME := weight-processor-sam
DOCKER_COMPOSE := docker-compose -f $(COMPOSE_FILE)

.PHONY: help docker-up docker-down docker-build docker-shell docker-logs \
        sam-build sam-api sam-invoke sam-test docker-clean docker-restart \
        docker-init-db docker-status

# Default target
help:
	@echo "Docker SAM Development Commands"
	@echo "================================"
	@echo ""
	@echo "Environment Management:"
	@echo "  make docker-up        - Start Docker SAM environment"
	@echo "  make docker-down      - Stop Docker SAM environment"
	@echo "  make docker-restart   - Restart Docker SAM environment"
	@echo "  make docker-status    - Show container status"
	@echo "  make docker-clean     - Stop and remove all containers/volumes"
	@echo ""
	@echo "SAM Operations:"
	@echo "  make sam-build        - Build SAM application in container"
	@echo "  make sam-api          - Start SAM Local API (http://localhost:3000)"
	@echo "  make sam-invoke F=<func> - Invoke Lambda function"
	@echo "  make sam-test         - Run tests in container"
	@echo ""
	@echo "Database:"
	@echo "  make docker-init-db   - Initialize DynamoDB tables"
	@echo "  make docker-db-admin  - Open DynamoDB Admin UI"
	@echo ""
	@echo "Development:"
	@echo "  make docker-shell     - Open bash shell in SAM container"
	@echo "  make docker-logs      - Show container logs"
	@echo "  make docker-build     - Rebuild Docker images"

# Start Docker environment
docker-up:
	@echo "🚀 Starting Docker SAM environment..."
	@$(DOCKER_COMPOSE) up -d
	@echo "⏳ Waiting for services to be ready..."
	@sleep 5
	@for i in {1..30}; do \
		if $(DOCKER_COMPOSE) exec -T dynamodb-local curl -s http://localhost:8000 > /dev/null 2>&1; then \
			echo "✅ DynamoDB is ready"; \
			break; \
		fi; \
		echo -n "."; \
		sleep 1; \
	done
	@echo ""
	@echo "✅ Docker SAM environment is ready!"
	@echo "📊 DynamoDB Admin UI: http://localhost:8001"

# Stop Docker environment
docker-down:
	@echo "🛑 Stopping Docker SAM environment..."
	@$(DOCKER_COMPOSE) down

# Rebuild Docker images
docker-build:
	@echo "🔨 Building Docker images..."
	@$(DOCKER_COMPOSE) build --no-cache

# Open shell in SAM container
docker-shell:
	@echo "🖥️ Opening shell in SAM container..."
	@$(DOCKER_COMPOSE) exec sam-builder bash

# Show logs
docker-logs:
	@$(DOCKER_COMPOSE) logs -f

# Show container status
docker-status:
	@echo "📊 Container Status:"
	@$(DOCKER_COMPOSE) ps

# Clean everything (including volumes)
docker-clean:
	@echo "🧹 Cleaning Docker environment..."
	@$(DOCKER_COMPOSE) down -v
	@echo "✅ Docker environment cleaned"

# Restart environment
docker-restart: docker-down docker-up

# Initialize DynamoDB
docker-init-db:
	@echo "🗄️ Initializing DynamoDB tables..."
	@$(DOCKER_COMPOSE) exec -T sam-builder python scripts/init-dynamodb.py
	@echo "✅ DynamoDB tables initialized"

# Open DynamoDB Admin
docker-db-admin:
	@echo "📊 Opening DynamoDB Admin UI..."
	@open http://localhost:8001 || xdg-open http://localhost:8001 || echo "Please open http://localhost:8001 in your browser"

# Build SAM application
sam-build: docker-up
	@echo "🔨 Building SAM application..."
	@$(DOCKER_COMPOSE) exec -T sam-builder bash -c "cd aws && sam build --template template.yaml"
	@echo "✅ SAM application built"

# Start SAM Local API
sam-api: sam-build
	@echo "🚀 Starting SAM Local API..."
	@echo "📡 API will be available at http://localhost:3000"
	@$(DOCKER_COMPOSE) exec sam-builder bash -c "\
		cd aws && \
		sam local start-api \
			--host 0.0.0.0 \
			--port 3000 \
			--docker-network sam-network \
			--container-host host.docker.internal \
			--parameter-overrides \
				Environment=local \
				ParameterKey=DynamoDBEndpoint,ParameterValue=http://dynamodb-local:8000"

# Invoke Lambda function
sam-invoke: docker-up
	@if [ -z "$(F)" ]; then \
		echo "❌ Error: Function name required. Usage: make sam-invoke F=WeightProcessorFunction"; \
		exit 1; \
	fi
	@echo "⚡ Invoking function: $(F)"
	@if [ -n "$(E)" ]; then \
		$(DOCKER_COMPOSE) exec -T sam-builder bash -c "cd aws && sam local invoke $(F) --event $(E) --docker-network sam-network"; \
	else \
		$(DOCKER_COMPOSE) exec -T sam-builder bash -c "cd aws && sam local invoke $(F) --docker-network sam-network"; \
	fi

# Run tests in container
sam-test: docker-up
	@echo "🧪 Running tests in container..."
	@$(DOCKER_COMPOSE) exec -T sam-builder python -m pytest tests/ -xvs

# Quick start for development
quick-start: docker-up docker-init-db
	@echo "🎉 Development environment is ready!"
	@echo ""
	@echo "Next steps:"
	@echo "  1. Run 'make sam-api' to start the API"
	@echo "  2. Open http://localhost:3000 to access the API"
	@echo "  3. Open http://localhost:8001 for DynamoDB Admin"
	@echo ""
	@echo "Or run 'make docker-shell' to work inside the container"

# Test API endpoint
test-api-health:
	@echo "🏥 Testing API health endpoint..."
	@curl -s http://localhost:3000/api/v1/health | jq '.' || echo "API might not be running. Start it with 'make sam-api'"

# Example: Process measurements
test-api-process:
	@echo "📊 Testing process endpoint..."
	@curl -X POST http://localhost:3000/api/v1/process/test-user \
		-H "Content-Type: application/json" \
		-d '{"measurements": [{"value": 75.5, "unit": "kg", "timestamp": "2024-01-01T10:00:00Z", "source": "patient-device"}]}' \
		| jq '.'