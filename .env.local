# Local development environment - DynamoDB Local configuration
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_SESSION_TOKEN=local
AWS_DEFAULT_REGION=us-east-1
SAM_CLI_TELEMETRY=0

# Disable credential checks
AWS_SAM_LOCAL=true
AWS_PROFILE=none

# DynamoDB configuration for local development (REQUIRED)
# Start DynamoDB Local with: docker-compose up -d dynamodb-local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=weight-processor-state