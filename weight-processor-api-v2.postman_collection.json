{
  "info": {
    "_postman_id": "weight-processor-v2",
    "name": "Weight Processor API v2",
    "description": "API collection for Weight Processor Service with Docker SAM support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Local Development (Docker SAM)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{docker_base_url}}/api/v1/health",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "response": []
        },
        {
          "name": "Process Measurements",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"measurements\": [\n    {\n      \"uuid\": \"{{$guid}}\",\n      \"weight\": 75.5,\n      \"unit\": \"kg\",\n      \"effectiveDateTime\": \"{{$isoTimestamp}}\",\n      \"source\": \"patient-device\",\n      \"metadata\": {\n        \"device\": \"scale-001\",\n        \"location\": \"home\"\n      }\n    },\n    {\n      \"uuid\": \"{{$guid}}\",\n      \"weight\": 75.8,\n      \"unit\": \"kg\",\n      \"effectiveDateTime\": \"{{$isoTimestamp}}\",\n      \"source\": \"care-team-upload\"\n    }\n  ],\n  \"options\": {\n    \"force_replay\": false\n  }\n}"
            },
            "url": {
              "raw": "{{docker_base_url}}/api/v1/process/{{userId}}",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "process", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get User State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{docker_base_url}}/api/v1/state/{{userId}}",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "state", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Replay Measurements",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"replay_from\": \"2024-01-01T00:00:00Z\",\n  \"measurements\": [\n    {\n      \"uuid\": \"{{$guid}}\",\n      \"weight\": 74.5,\n      \"unit\": \"kg\",\n      \"effectiveDateTime\": \"2024-01-01T10:00:00Z\",\n      \"source\": \"patient-device\"\n    },\n    {\n      \"uuid\": \"{{$guid}}\",\n      \"weight\": 74.8,\n      \"unit\": \"kg\",\n      \"effectiveDateTime\": \"2024-01-02T10:00:00Z\",\n      \"source\": \"patient-device\"\n    }\n  ],\n  \"options\": {\n    \"validate_order\": true,\n    \"stop_on_error\": false\n  }\n}"
            },
            "url": {
              "raw": "{{docker_base_url}}/api/v1/replay/{{userId}}",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "replay", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Cleanup User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cleanup_type\": \"reset_adaptive\",\n  \"options\": {\n    \"preserve_buffer\": false,\n    \"preserve_kalman\": false\n  }\n}"
            },
            "url": {
              "raw": "{{docker_base_url}}/api/v1/cleanup/{{userId}}",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "cleanup", "{{userId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete User State",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{docker_base_url}}/api/v1/state/{{userId}}",
              "host": ["{{docker_base_url}}"],
              "path": ["api", "v1", "state", "{{userId}}"]
            }
          },
          "response": []
        }
      ]
    },
