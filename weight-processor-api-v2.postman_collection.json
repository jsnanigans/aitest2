  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a random user ID if not set",
          "if (!pm.variables.get('userId')) {",
          "    pm.variables.set('userId', 'test-user-' + Date.now());",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts",
          "pm.test('Status code is 200', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response has JSON body', function () {",
          "    pm.response.to.be.json;",
          "});",
          "",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "docker_base_url",
      "value": "http://localhost:3080",
      "type": "string"
    },
    {
      "key": "aws_dev_url",
      "value": "https://your-api-id.execute-api.us-east-1.amazonaws.com/dev",
      "type": "string"
    },
    {
      "key": "aws_prod_url",
      "value": "https://your-api-id.execute-api.us-east-1.amazonaws.com/prod",
      "type": "string"
    },
    {
      "key": "api_key_dev",
      "value": "your-dev-api-key",
      "type": "string"
    },
    {
      "key": "api_key_prod",
      "value": "your-prod-api-key",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "test-user-001",
      "type": "string"
    }
  ]
}